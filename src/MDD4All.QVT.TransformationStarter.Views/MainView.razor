@using Microsoft.AspNetCore.Components.Web
<div class="mainContainer">

    <div class="topRow">
        <img src="images/ModelTransformatorLogo.png"
             height="50" />

        

        <strong>@L["Label.Transformation"] @DescriptorProvider.TransformationDescriptor.TransformationName</strong>

    </div>

    <div class="contentPanel">
        @switch (DataContext.ActiveViewState)
        {
            case ViewModels.ViewState.TransformationStart:
                <TransformationStartView DataContext="DataContext" />
                break;

            case ViewModels.ViewState.TransformationRunning:
                <TransformationRunningView />
                break;

            case ViewModels.ViewState.TransformationFinished:
                <TransformationFinishedView DataContext="DataContext" />
                break;
        }
    </div>

    <div class="statusPanel">
        @if (!string.IsNullOrEmpty(DataContext.StatusMessageTitle))
        {
            <span>
                @L[DataContext.StatusMessageTitle]
            </span>
        }
    </div>


</div>


